#!/bin/sh
# Pre-commit hook for SyntropicOS (Always Container-based)

echo "=== [Pre-Commit] Running Container Code Formatting (make container-format FIX=1) ==="

MAKE_BIN="make"
if command -v mingw32-make >/dev/null 2>&1 && ! command -v make >/dev/null 2>&1; then
    MAKE_BIN="mingw32-make"
fi

$MAKE_BIN container-format FIX=1
git add -u

echo "=== [Pre-Commit] Container Formatting Complete ==="
exit 0
