{
  "name": "SyntropicOS",
  "version": "2026.7.1",
  "description": "Zero-overhead C99 bare-metal framework & cooperative OS. Features protothreads, zero heap allocation, fixed-point math, DSP, FOC motor control, EtherCAT, CANopen, J1939, Modbus, and WireGuard.",
  "keywords": [
    "protothreads",
    "cooperative-rtos",
    "coroutine",
    "zero-heap",
    "bare-metal",
    "ethercat",
    "canopen",
    "j1939",
    "modbus",
    "wireguard",
    "nmea0183",
    "smbus",
    "pmbus",
    "foc-motor-control",
    "kalman-filter",
    "svpwm",
    "biquad-filter",
    "fixed-point-math",
    "stm32",
    "rp2040"
  ],
  "authors": [
    {
      "name": "Charles Galant",
      "email": "cgalant@gmail.com",
      "url": "https://github.com/outlookhazy"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/outlookhazy/SyntropicOS.git"
  },
  "homepage": "https://github.com/outlookhazy/SyntropicOS",
  "license": "Apache-2.0",
  "frameworks": "*",
  "platforms": "*",
  "headers": [
    "SyntropicOS.h",
    "syntropic/syntropic.h"
  ],
  "build": {
    "flags": [
      "-Isrc",
      "-Isrc/syntropic"
    ],
    "srcFilter": [
      "+<*>",
      "-<syntropic/port_stubs/>"
    ]
  }
}
