# SyntropicOS Lightweight Test Container
FROM debian:bookworm-slim

# Install compilation tools, sanitizers, cross-compilers, QEMU ARM, and libFuzzer RT libraries
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    clang \
    libclang-rt-dev \
    make \
    cmake \
    git \
    libasan8 \
    libubsan1 \
    gcc-arm-none-eabi \
    libnewlib-arm-none-eabi \
    qemu-system-arm \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

CMD ["make", "-C", "toolchain/testing", "help"]
